# ---------------------------------------------------------------------------
# AsbestHub - omgevingsvariabelen
# Kopieer naar .env (lokaal) of stel in via Vercel Project Settings.
# ---------------------------------------------------------------------------

# Neon Postgres. Gebruik de "pooled" connection string (met -pooler) op Vercel.
# Extensies pgvector en pg_trgm worden door de eerste migratie aangemaakt.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/asbesthub?sslmode=require

# Clerk (auth + organisaties). Maak in Clerk Organizations aan met de rollen
# org:admin, org:projectleider, org:beoordelaar, org:lezer, org:extern.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Anthropic (redeneren, schrijven, beoordelen) en OpenAI (embeddings, Whisper).
ANTHROPIC_API_KEY=sk-ant-xxx
OPENAI_API_KEY=sk-xxx
# Optioneel: modelkeuze overschrijven. Standaard: claude-sonnet-4-6 en claude-haiku-4-5.
AI_MODEL_REASONING=claude-sonnet-4-6
AI_MODEL_FAST=claude-haiku-4-5
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Upstash Redis (rate limiting) en QStash (achtergrondtaken voor lange AI-taken).
# Zonder QSTASH_TOKEN draaien AI-taken in-process na het antwoord (alleen voor lokale ontwikkeling).
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx
QSTASH_TOKEN=xxx
QSTASH_CURRENT_SIGNING_KEY=sig_xxx
QSTASH_NEXT_SIGNING_KEY=sig_xxx

# Vercel Blob voor bestandsopslag. Zonder token worden bestanden lokaal in
# LOCAL_STORAGE_DIR opgeslagen (alleen development; productie vereist het token).
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
LOCAL_STORAGE_DIR=.local-storage

# Resend voor e-mail (uitnodigingen beoordelaars, accorderingsverzoeken, herinneringen).
RESEND_API_KEY=re_xxx
EMAIL_FROM="AsbestHub <noreply@jouwdomein.nl>"

# Publieke URL van de app (voor links in e-mails en QStash callbacks).
APP_URL=http://localhost:3000

# Geheim voor de cron-route /api/cron/reminders (Vercel Cron stuurt dit als Bearer token).
CRON_SECRET=verander-dit

# Alleen voor Playwright e2e-tests: een bestaande Clerk-testgebruiker in een organisatie met rol projectleider.
E2E_CLERK_USER_EMAIL=
E2E_CLERK_USER_PASSWORD=
