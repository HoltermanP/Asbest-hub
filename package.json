    "next": "15",
    "next-themes": "^0.4.6",
    "openai": "^7.10.0",
    "postgres": "^3.4.9",
    "react": "19",
    "react-dom": "19",
    "resend": "^6.26.0",
    "server-only": "^0.0.1",
