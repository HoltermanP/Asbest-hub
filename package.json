{
  "name": "asbesthub",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx --import ./scripts/register-shims.mjs src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "knowledge:import": "tsx --import ./scripts/register-shims.mjs scripts/import-knowledge.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
